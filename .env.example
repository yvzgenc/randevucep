NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Super-admin emails (comma-separated)
ADMIN_EMAILS=admin@example.com

# ── Payment provider ────────────────────────────────────────────────────────
# Active provider: iyzico (default)
PAYMENT_PROVIDER=iyzico

# iyzico credentials (https://merchant.iyzipay.com)
IYZICO_API_KEY=your-iyzico-api-key
IYZICO_SECRET_KEY=your-iyzico-secret-key
# Sandbox: https://sandbox.iyzipay.com  |  Production: https://api.iyzipay.com
IYZICO_BASE_URL=https://sandbox.iyzipay.com

# Public app URL (used for payment callback redirect)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Supabase service-role key (webhook handler only — NEVER expose to browser)
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key
